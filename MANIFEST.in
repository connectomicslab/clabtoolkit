include AUTHORS.rst
include CONTRIBUTING.rst
include HISTORY.rst
include LICENSE
include README.rst
include pyproject.toml

# Project metadata and reproducible environments
include DOCUMENTATION.md
include architecture_diagram.md
include Makefile
include tox.ini
include requirements.txt
include requirements_dev.txt
include requirements-docs.txt
include environment.yaml
include environment-mac.yaml

# Include package source code
recursive-include clabtoolkit *.py
recursive-include clabtoolkit/config *.json

# Include documentation
recursive-include docs *.rst *.py *.bat *.png *.ico
recursive-include docs Makefile
include docs/make.bat

# Include usage examples
recursive-include usage_examples *.ipynb *.py *.md

# EXCLUDE tests data completely
prune tests

# Build output and tool caches must never reach the sdist
prune docs/build
prune usage_examples/nilearn_cache

# Exclude unwanted files (only those that exist)
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
